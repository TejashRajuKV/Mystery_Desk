{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(**/solution.json)",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-solution-edit.ps1"
            ],
            "statusMessage": "Checking solution.json protection..."
          },
          {
            "type": "command",
            "if": "Write(**/solution.json)",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-solution-edit.ps1"
            ],
            "statusMessage": "Checking solution.json protection..."
          },
          {
            "type": "command",
            "if": "Write(*.ts)",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-typescript-tailwind.ps1"
            ],
            "statusMessage": "Checking stack compliance (no TypeScript)..."
          },
          {
            "type": "command",
            "if": "Write(*.tsx)",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-typescript-tailwind.ps1"
            ],
            "statusMessage": "Checking stack compliance (no TypeScript)..."
          },
          {
            "type": "command",
            "if": "Write(**/tailwind.config*)",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-typescript-tailwind.ps1"
            ],
            "statusMessage": "Checking stack compliance (no Tailwind)..."
          },
          {
            "type": "command",
            "if": "Write(*.test.*)",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-test-files.ps1"
            ],
            "statusMessage": "Checking test file policy..."
          },
          {
            "type": "command",
            "if": "Write(*.spec.*)",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-test-files.ps1"
            ],
            "statusMessage": "Checking test file policy..."
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(npm install *)",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-unauthorized-deps.ps1"
            ],
            "statusMessage": "Checking dependency approval..."
          },
          {
            "type": "command",
            "if": "Bash(npm i *)",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-unauthorized-deps.ps1"
            ],
            "statusMessage": "Checking dependency approval..."
          },
          {
            "type": "command",
            "if": "Bash(npm add *)",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-unauthorized-deps.ps1"
            ],
            "statusMessage": "Checking dependency approval..."
          },
          {
            "type": "command",
            "if": "Bash(rm *)",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-destructive-commands.ps1"
            ],
            "statusMessage": "Checking for destructive operations..."
          },
          {
            "type": "command",
            "if": "PowerShell(Remove-Item *)",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-destructive-commands.ps1"
            ],
            "statusMessage": "Checking for destructive operations..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(**/frontend/src/**/*.jsx)",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-frontend-no-hardcoded-data.ps1"
            ],
            "statusMessage": "Scanning for hardcoded case data..."
          },
          {
            "type": "command",
            "if": "Write(**/frontend/src/**/*.jsx)",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-frontend-no-hardcoded-data.ps1"
            ],
            "statusMessage": "Scanning for hardcoded case data..."
          },
          {
            "type": "command",
            "if": "Edit(**/frontend/src/**)",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-absolute-backend-url.ps1"
            ],
            "statusMessage": "Checking for absolute backend URLs..."
          },
          {
            "type": "command",
            "if": "Write(**/frontend/src/**)",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-absolute-backend-url.ps1"
            ],
            "statusMessage": "Checking for absolute backend URLs..."
          },
          {
            "type": "command",
            "if": "Edit(**/frontend/src/**/*.css)",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-css-uses-tokens.ps1"
            ],
            "statusMessage": "Checking CSS token usage..."
          },
          {
            "type": "command",
            "if": "Write(**/frontend/src/**/*.css)",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-css-uses-tokens.ps1"
            ],
            "statusMessage": "Checking CSS token usage..."
          },
          {
            "type": "command",
            "if": "Edit(**/backend/src/routes/**)",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-route-no-logic.ps1"
            ],
            "statusMessage": "Checking route architecture..."
          },
          {
            "type": "command",
            "if": "Write(**/backend/src/routes/**)",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-route-no-logic.ps1"
            ],
            "statusMessage": "Checking route architecture..."
          },
          {
            "type": "command",
            "if": "Edit(**/backend/src/controllers/**)",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-api-response-shape.ps1"
            ],
            "statusMessage": "Checking API response shape..."
          },
          {
            "type": "command",
            "if": "Write(**/backend/src/controllers/**)",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/check-api-response-shape.ps1"
            ],
            "statusMessage": "Checking API response shape..."
          }
        ]
      }
    ]
  }
}
